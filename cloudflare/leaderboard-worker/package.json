{
  "name": "gumpjam-leaderboard-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --local",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create gumpjam-leaderboard",
    "db:init:local": "wrangler d1 execute gumpjam-leaderboard --local --file=./schema.sql",
    "db:init:remote": "wrangler d1 execute gumpjam-leaderboard --remote --file=./schema.sql"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "typescript": "latest",
    "wrangler": "latest"
  }
}
